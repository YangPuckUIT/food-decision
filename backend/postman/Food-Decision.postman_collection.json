{
  "info": {
    "name": "Food Decision — offline Backend Brief contract",
    "description": "Run only against npm run test:fixture at 127.0.0.1:3001 with Offline environment. No Atlas connection. Exact assertions target the 12 in-memory fixtures. Lower gacha boundary returns 404 because this fixture has no 20000 food; automated HTTP tests separately cover equality at 20000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"Health shape\", () => { pm.expect(result).to.eql({status:\"ok\"}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Catalog sorted by price",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/foods"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"12 fixture foods, ascending price\", () => { pm.expect(result.data).to.have.lengthOf(12); pm.expect(result.data.map(f=>f.price)).to.eql(result.data.map(f=>f.price).sort((a,b)=>a-b)); });"
