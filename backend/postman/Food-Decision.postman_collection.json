    {
      "name": "Group",
      "item": [
        {
          "name": "All three reasons, precedence, input order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/group-decision",
            "body": {
              "mode": "raw",
              "raw": "{\"foodIds\": [\"000000000000000000000001\", \"000000000000000000000002\", \"000000000000000000000003\", \"000000000000000000000004\", \"000000000000000000000005\"], \"budget\": 70000, \"noSpicy\": true, \"avoidCategories\": [\"Rice\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"Finalist\", () => { pm.expect(result.data.finalists.map(f=>f._id)).to.eql([\"000000000000000000000001\"]); });",
                  "pm.test(\"Eliminations and precedence\", () => { pm.expect(result.data.eliminated.map(x=>[x.food._id,x.reason])).to.eql([[\"000000000000000000000002\",\"TOO_SPICY\"],[\"000000000000000000000003\",\"AVOIDED_CATEGORY\"],[\"000000000000000000000004\",\"OVER_BUDGET\"],[\"000000000000000000000005\",\"OVER_BUDGET\"]]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Default noSpicy and avoided categories",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/group-decision",
            "body": {
              "mode": "raw",
              "raw": "{\"foodIds\": [\"000000000000000000000002\", \"000000000000000000000001\"], \"budget\": 50000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"Both finalists in input order\", () => { pm.expect(result.data.finalists.map(f=>f._id)).to.eql([\"000000000000000000000002\",\"000000000000000000000001\"]); pm.expect(result.data.eliminated).to.eql([]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Zero finalists still 200",
          "request": {
            "method": "POST",
            "header": [
